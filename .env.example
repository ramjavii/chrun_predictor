# IDS — Environment Variables
# Copy this file to .env and fill in your values.

# PostgreSQL
POSTGRES_USER=ids_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ids
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-insecure-change-in-production

# Model Registry
MODEL_REGISTRY_PATH=/data/models

# Training
TRAINING_DATA_PATH=/data/raw/training_data.parquet
RANDOM_SEED=42

# Stripe (optional — only needed for webhook endpoint)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Logging
LOG_LEVEL=INFO
